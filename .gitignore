# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from the github site
# https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/[Ss]treamingAssets/aa.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Gradle cache
.gradle/

# Autogenerated cache
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures
/[Mm]emoryCaptures/
/[Pp]rofilerCaptures/

# Asset server cache
/[Aa]sset_Server_Cache/

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary cache generated when downloading Assets
/[Aa]ssets/[Ss]treamingAssets/aa.hash

# OS generated
.DS_Store*
Thumbs.db
ehthumbs.db
[Tt]humbs.db
Desktop.ini

# Visual Studio / Rider / VS Code
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity personal information
.consulo/
*.private
*.private.data
*.private.data.meta
